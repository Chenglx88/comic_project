{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "单集剧本",
  "type": "object",
  "required": [
    "episode_id",
    "major",
    "major_en",
    "realm",
    "protagonist",
    "logline",
    "beats",
    "knowledge_points",
    "characters",
    "mentor_portrait",
    "next_episode_hook",
    "continuity",
    "sources"
  ],
  "properties": {
    "episode_id": {"type": "string", "pattern": "^EP\\d{2}$"},
    "major": {"type": "string", "minLength": 2},
    "major_en": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "realm": {"type": "string", "enum": ["修仙境", "机枢城", "万象医馆", "星渊观测所", "言灵殿"]},
    "protagonist": {"type": "string", "enum": ["undecided", "lie", "mirror"]},
    "logline": {"type": "string", "minLength": 10},
    "beats": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["index", "name", "start_sec", "end_sec", "summary"],
        "properties": {
          "index": {"type": "integer", "minimum": 1, "maximum": 5},
          "name": {"type": "string"},
          "start_sec": {"type": "number", "minimum": 0},
          "end_sec": {"type": "number", "minimum": 0},
          "summary": {"type": "string", "minLength": 5}
        }
      }
    },
    "knowledge_points": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "title", "explain", "misconception", "source_ref"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "explain": {"type": "string", "minLength": 5},
          "misconception": {"type": "string"},
          "source_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "characters": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "mentor_portrait": {
      "type": "object",
      "required": ["imagery", "metrics", "note"],
      "properties": {
        "imagery": {"type": "string", "minLength": 5},
        "metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "note": {"type": "string", "minLength": 4}
      }
    },
    "next_episode_hook": {"type": "string", "minLength": 3},
    "continuity": {
      "type": "object",
      "required": ["prev_summary", "open_threads"],
      "properties": {
        "prev_summary": {"type": "string"},
        "open_threads": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "retrieved_at", "year"],
        "properties": {
          "url": {"type": "string", "minLength": 5},
          "retrieved_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "year": {"type": "integer", "minimum": 2000}
        }
      }
    }
  },
  "x-constraints": {
    "beats_duration_total_sec": [170, 190],
    "mentor_note_must_contain": "综合画像"
  }
}
