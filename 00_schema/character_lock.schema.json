{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "角色锁",
  "type": "object",
  "required": ["version", "updated", "protagonists"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "protagonists": {
      "type": "object",
      "required": ["lie", "mirror"],
      "additionalProperties": {
        "type": "object",
        "required": [
          "display_name",
          "visual_anchors",
          "palette",
          "outfit",
          "expressions",
          "seed_range",
          "reference_images",
          "prompt_prefix"
        ],
        "properties": {
          "display_name": {"type": "string"},
          "visual_anchors": {"type": "array", "items": {"type": "string"}},
          "palette": {"type": "object"},
          "outfit": {"type": "object"},
          "expressions": {"type": "array", "minItems": 5, "items": {"type": "string"}},
          "seed_range": {"type": ["array", "null"], "items": {"type": "integer"}},
          "reference_images": {"type": "array", "items": {"type": "string"}},
          "prompt_prefix": {"type": "string"}
        }
      }
    }
  }
}
