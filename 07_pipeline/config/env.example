# 《五境试炼》EP01 环境变量模板
# 复制为 07_pipeline/config/.env（或项目根 .env）后填写；.env 已被 .gitignore 忽略。
# 本文件只放变量名和默认值，不放任何真实密钥。

# L1 腾讯云 TokenHub（OpenAI 兼容）+ 联网搜索
# 旧 TENCENTCLOUD_SECRET_ID/SECRET_KEY 不再用于 L1；TokenHub 使用 sk- 开头的 API Key
TOKENHUB_API_KEY=
# 广州站；新加坡站为 https://tokenhub-intl.tencentcloudmaas.com/v1，两站 Key 不互通
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
# 可用模型：hy4 / hy4-preview / hy3 / deepseek-v4.1-flash-1017；以控制台实时目录为准
# 注意：L1 实际模型 pin 在 07_pipeline/config/routing.json 的 layers.L1.model；
# 本变量仅作后备。hy4 与 TokenHub 搜索注入不兼容，当前 L1 pin 为 deepseek-v4.1-flash-1017。
HUNYUAN_MODEL_ID=deepseek-v4.1-flash-1017
# 联网搜索走 Chat Completions 的 web_search_options；需在控制台领取/开通搜索资源包
HUNYUAN_SEARCH_ENABLED=1
HUNYUAN_SEARCH_SOURCE=standard

# L2 阿里云百炼 Qwen
DASHSCOPE_API_KEY=
# 精确 ID 区分大小写：qwen3.6-plus-2026-04-02（或 qwen3.6-plus）
QWEN_MODEL_ID=

# L3 DeepSeek
DEEPSEEK_API_KEY=
# 当前可用：deepseek-flash / deepseek-v4-pro
DEEPSEEK_MODEL_ID=
# 必须是 OpenAI 兼容根地址；不要填 https://api.deepseek.com/anthropic
DEEPSEEK_BASE_URL=https://api.deepseek.com

# L4/L5 智谱 GLM
ZHIPU_API_KEY=
# 当前实测：glm-5.3；reasoning 模型，max_tokens 要留足
GLM_MODEL_ID=

# L6 火山方舟豆包
ARK_API_KEY=
# 必须是 chat 类型的推理接入点；不要填 Seedream/Seedance 的图像/视频 endpoint
DOUBAO_ENDPOINT_ID=
ARK_REGION=cn-beijing

# 图像 即梦 / Seedream（火山方舟，与 L6 共用 ARK_API_KEY）
# 必须是 Seedream 图像推理接入点；不要复用 DOUBAO_ENDPOINT_ID
SEEDREAM_ENDPOINT_ID=
# 当前实测模型：doubao-seedream-5-5-261028（需在控制台开通）
SEEDREAM_MODEL_ID=

# 视频 可灵（新版单 API key）
KLING_API_KEY=
# 当前官方 v3 路径：kling-3.0
KLING_MODEL=

# 配音 火山 TTS（新版单 API Key + Cluster）
# 标准端点：https://openspeech.bytedance.com/api/v3/tts/unidirectional
# 不要加 /sse；实测 /unidirectional/sse 会误报 45000030 resource not granted
VOLC_TTS_API_KEY=
# 控制台实际资源 ID；seed-tts-2.0 与 *_uranus_bigtts 音色配套，以授权为准
VOLC_TTS_CLUSTER=
VOLC_TTS_VOICE_LIE=
VOLC_TTS_VOICE_MIRROR=
VOLC_TTS_VOICE_MENTOR=

# 预算（元）
MAX_BUDGET_CNY=200
